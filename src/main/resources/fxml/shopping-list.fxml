<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?> <?import javafx.scene.control.ComboBox?> <?import javafx.scene.control.Label?> <?import javafx.scene.control.ListView?> <?import javafx.scene.layout.BorderPane?> <?import javafx.scene.layout.HBox?> <?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pantry.controller.ShoppingListController">

<top>

<HBox spacing="20" styleClass="content">

<Button text="Home" onAction="#goHome"/>

<Label text="Shopping List" styleClass="page-title"/>

</HBox>

</top>

<center>

<VBox spacing="15" styleClass="content">

<Label text="Choose a Recipe" styleClass="section-title"/>

<ComboBox fx:id="recipeComboBox" promptText="Select a recipe" prefWidth="300"/>

<Button text="Generate Shopping List" onAction="#generateShoppingList"/>

<Label text="Items Needed" styleClass="section-title"/>

<ListView fx:id="shoppingListView"/>

</VBox>

</center>

</BorderPane>