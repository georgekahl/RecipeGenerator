<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pantry.HomeController">

    <left>
        <VBox styleClass="sidebar" spacing="15">

            <Label text="Recipe Generator"
                   styleClass="app-title"/>

            <VBox spacing="8">

                <Button text="Home"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction = "#openHome"/>

                <Button text="Pantry"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction = "#openPantry"/>

                <Button text="Recipes"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction = "#openRecipes"/>

                <Button text="Shopping List"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction = "#openShoppingList"/>

            </VBox>

        </VBox>
    </left>

    <center>
        <VBox styleClass="content" spacing="20">

            <Label text="Dashboard"
                   styleClass="page-title"/>

            <Label text="Welcome to your Recipe Generator"
                   styleClass="subtitle"/>

            <HBox spacing="15">

                <VBox styleClass="stat-card" spacing="5">
                    <Label text="Pantry"
                           styleClass="stat-title"/>

                    <Label fx:id="pantryCount"
                           text="0"
                           styleClass="stat-number"/>

                    <Label text="Ingredients"
                           styleClass="stat-description"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="5">
                    <Label text="Recipes"
                           styleClass="stat-title"/>

                    <Label fx:id="recipeCount"
                           text="0"
                           styleClass="stat-number"/>

                    <Label text="Available recipes"
                           styleClass="stat-description"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="5">
                    <Label text="Expiring Soon"
                           styleClass="stat-title"/>

                    <Label fx:id="expiringCount"
                           text="0"
                           styleClass="stat-number"/>

                    <Label text="Ingredients expiring"
                           styleClass="stat-description"/>
                </VBox>

            </HBox>

            <Label text="Pantry"
                   styleClass="section-title"/>

            <VBox styleClass="pantry-preview">

                <Label text="Your pantry is currently empty."
                       styleClass="empty-message"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>